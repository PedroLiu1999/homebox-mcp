# Container image published to GitHub Container Registry
IMAGE=ghcr.io/owner/homebox-mcp:latest

# HTTP port the MCP server listens on
PORT=3000

# Base URL of your Homebox instance (without trailing slash)
HOMEBOX_URL=http://homebox:7745

# Publicly reachable origin of this MCP server used in OAuth 2.1 metadata and redirects.
# When running behind a reverse proxy (Caddy, Traefik, Nginx), set this to the external HTTPS URL.
MCP_PUBLIC_URL=https://mcp.example.com

# 32-byte key (64 hex characters or 32-byte base64) used to encrypt stored Homebox API keys (AES-256-GCM).
# Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Express trust proxy setting for reverse proxies (e.g. 1 hop, true, false, loopback, or IP/CIDR).
# Defaults to 1 so rate limiting and req.ip use the client IP forwarded by the immediate proxy.
TRUST_PROXY=1
